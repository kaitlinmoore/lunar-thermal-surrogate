# Main checkout: ~/.venvs/lunar-thermal-surrogate. Worktree <name>: ~/.venvs/lunar-thermal-surrogate--<name>.
main="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
env_name="$(basename "$main")"
[ "$PWD" != "$main" ] && env_name="$env_name--$(basename "$PWD")"
export UV_PROJECT_ENVIRONMENT="$HOME/.venvs/$env_name"
# .env is gitignored and lives only in the main checkout; every worktree loads that one.
dotenv_if_exists "$main/.env"
